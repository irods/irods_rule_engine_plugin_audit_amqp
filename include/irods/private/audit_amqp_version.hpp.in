#ifndef IRODS_AUDIT_AMQP_VERSION_HPP
#define IRODS_AUDIT_AMQP_VERSION_HPP

#include <boost/preprocessor/stringize.hpp>
#include <proton/version.h>

#define IRODS_AUDIT_AMQP_VERSION            "@IRODS_PLUGIN_VERSION@"
#define IRODS_AUDIT_AMQP_VERSION_MAJOR      @PROJECT_VERSION_MAJOR@
#define IRODS_AUDIT_AMQP_VERSION_MINOR      @PROJECT_VERSION_MINOR@
#define IRODS_AUDIT_AMQP_VERSION_PATCH      @PROJECT_VERSION_PATCH@
#define IRODS_AUDIT_AMQP_VERSION_INTEGER    (@PROJECT_VERSION_MAJOR@*1000000 + @PROJECT_VERSION_MINOR@*1000 + @PROJECT_VERSION_PATCH@)

#ifndef IRODS_VERSION
#define IRODS_VERSION                       "@IRODS_VERSION@"
#endif

#define IRODS_QPID_PROTON_VERSION           BOOST_PP_STRINGIZE(PN_VERSION_MAJOR) "." BOOST_PP_STRINGIZE(PN_VERSION_MINOR) "." BOOST_PP_STRINGIZE(PN_VERSION_POINT)
#define IRODS_QPID_PROTON_VERSION_INTEGER   (PN_VERSION_MAJOR*1000000 + PN_VERSION_MINOR*1000 + PN_VERSION_POINT)

#endif  // IRODS_AUDIT_AMQP_VERSION_HPP
